<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>LeanBack</RootNamespace>
    <AssemblyName>LeanBack</AssemblyName>
    <AssemblyTitle>LeanBack — Smart project backup</AssemblyTitle>
    <Product>LeanBack</Product>
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\leanback.ico</ApplicationIcon>
    <DebugType>embedded</DebugType>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- We hand-write Main so the hidden headless CLI mode still works. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!--
      Portable single-file deliverable. WinUI 3 supports PublishSingleFile only when the app
      is BOTH unpackaged and self-contained (Windows App SDK 1.5+). The SDK's
      WindowsAppSDKSingleFileVerifyConfiguration target hard-errors if any of
      EnableMsixTooling / WindowsPackageType=None / IncludeAllContentForSelfExtract is missing.
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.IO.Hashing" Version="8.0.0" />
  </ItemGroup>

</Project>
