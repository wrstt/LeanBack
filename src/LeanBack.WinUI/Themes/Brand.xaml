<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        LeanBack is a tool about subtraction: it copies only what can't be reinstalled.
        The palette encodes that distinction and nothing else does:
            cyan  = things only you have      (kept)
            amber = things you can regenerate (skipped)
        Everything else stays quiet so those two carry all the meaning.

        Both themes are authored deliberately rather than one being a tint of the other.
        Text colours differ per theme because the brand hues are mid-tone: #22D3EE on white
        is about 1.9:1, so light mode uses deeper cyan/amber for anything that is text.
        Saturated brand colour is kept for FILLS, where contrast is carried by what sits on it.
    -->
    <ResourceDictionary.ThemeDictionaries>

        <!-- ===================================================== LIGHT -->
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="Ink" Color="#FF07141F" />
            <SolidColorBrush x:Key="Slate" Color="#F2FFFFFF" />
            <SolidColorBrush x:Key="SlateHi" Color="#FFFFFFFF" />

            <!-- text-safe brand tones: ~5:1 on white -->
            <SolidColorBrush x:Key="Cyan" Color="#FF0E7490" />
            <SolidColorBrush x:Key="CyanDeep" Color="#FF0891B2" />
            <SolidColorBrush x:Key="Amber" Color="#FFA85B00" />

            <!-- fills keep the saturated brand hues -->
            <SolidColorBrush x:Key="AmberDim" Color="#FFF5A524" Opacity="0.75" />
            <SolidColorBrush x:Key="CyanSoft" Color="#FF22D3EE" Opacity="0.16" />
            <SolidColorBrush x:Key="ChipFill" Color="#22F5A524" />

            <SolidColorBrush x:Key="Ftext" Color="#FF0A1A26" />
            <SolidColorBrush x:Key="FtextDim" Color="#FF40596B" />
            <SolidColorBrush x:Key="FtextFaint" Color="#FF5B7385" />
            <SolidColorBrush x:Key="Hairline" Color="#1A000000" />
            <SolidColorBrush x:Key="RowFill" Color="#0A000000" />

            <LinearGradientBrush x:Key="CtaFill" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF22D3EE" Offset="0" />
                <GradientStop Color="#FF0891B2" Offset="1" />
            </LinearGradientBrush>
        </ResourceDictionary>

        <!-- ===================================================== DARK -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="Ink" Color="#FF07141F" />
            <SolidColorBrush x:Key="Slate" Color="#FF16232F" />
            <SolidColorBrush x:Key="SlateHi" Color="#FF1F303F" />

            <SolidColorBrush x:Key="Cyan" Color="#FF22D3EE" />
            <SolidColorBrush x:Key="CyanDeep" Color="#FF0891B2" />
            <SolidColorBrush x:Key="Amber" Color="#FFF5A524" />

            <SolidColorBrush x:Key="AmberDim" Color="#FFF5A524" Opacity="0.55" />
            <SolidColorBrush x:Key="CyanSoft" Color="#FF22D3EE" Opacity="0.14" />
            <SolidColorBrush x:Key="ChipFill" Color="#1FF5A524" />

            <SolidColorBrush x:Key="Ftext" Color="#FFE8F0F6" />
            <SolidColorBrush x:Key="FtextDim" Color="#FF93A9BC" />
            <SolidColorBrush x:Key="FtextFaint" Color="#FF87A0B5" />
            <SolidColorBrush x:Key="Hairline" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="RowFill" Color="#0AFFFFFF" />

            <LinearGradientBrush x:Key="CtaFill" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF22D3EE" Offset="0" />
                <GradientStop Color="#FF0891B2" Offset="1" />
            </LinearGradientBrush>
        </ResourceDictionary>

        <!-- ===================================================== HIGH CONTRAST -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="Ink" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="Slate" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SlateHi" Color="{ThemeResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="Cyan" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="CyanDeep" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="Amber" Color="{ThemeResource SystemColorHotlightColor}" />

            <SolidColorBrush x:Key="AmberDim" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="CyanSoft" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ChipFill" Color="{ThemeResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="Ftext" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FtextDim" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FtextFaint" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="Hairline" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RowFill" Color="Transparent" />

            <SolidColorBrush x:Key="CtaFill" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ================== theme-independent: type and shape ================== -->

    <!-- Filesystem data is literally shell strings, so it's set in a real terminal face. -->
    <FontFamily x:Key="MonoFace">Cascadia Mono, Consolas, Courier New</FontFamily>

    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFace}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource FtextDim}" />
    </Style>

    <Style x:Key="MonoTiny" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Foreground" Value="{ThemeResource FtextFaint}" />
    </Style>

    <!-- Small tracked-out eyebrow used to label each section. -->
    <Style x:Key="Eyebrow" TargetType="TextBlock" BasedOn="{StaticResource MonoTiny}">
        <Setter Property="CharacterSpacing" Value="180" />
        <Setter Property="Foreground" Value="{ThemeResource FtextFaint}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="SectionHead" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource Ftext}" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource Slate}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Hairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{ThemeResource ChipFill}" />
    </Style>

</ResourceDictionary>
